PORT=5000
# SQLite file (default: ../database/kisan.db)
# DB_PATH=../database/kisan.db
# Frontend origin allowed by CORS (default: any)
# CORS_ORIGIN=http://localhost:3000

# Required for protected admin database endpoints. Set a long random secret in your shell/deployment environment.
# ADMIN_API_KEY=replace-with-a-long-random-secret

# Admin login used by the Admin Portal (server-side check, session token). CHANGE THESE before deploying.
# Without ADMIN_PASSWORD the demo login admin@khetimandi.in / admin123 is used and a warning is printed.
# ADMIN_EMAIL=admin@khetimandi.in
# ADMIN_PASSWORD=choose-a-strong-password

# ---------- Mobile OTP (real SMS) ----------
# Leave SMS_PROVIDER empty for DEV MODE: the OTP is printed in this server's console and returned to the
# browser (never in NODE_ENV=production). To send REAL SMS pick ONE provider and fill its keys:
#
# SMS_PROVIDER=twilio-verify      # easiest for testing; handles India routing, you only need an account
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxx
#
# SMS_PROVIDER=msg91              # cheapest in India, needs DLT-registered OTP template + sender ID
# MSG91_AUTH_KEY=xxxxxxxx
# MSG91_TEMPLATE_ID=xxxxxxxx
#
# SMS_PROVIDER=fast2sms
# FAST2SMS_API_KEY=xxxxxxxx
#
# Long random secret used to hash OTPs (keeps pending OTPs valid across restarts)
# OTP_SECRET=replace-with-a-long-random-string
# Public URL of the frontend, encoded into the QR code on the Digital Kisan ID card
# PUBLIC_APP_URL=http://localhost:3000

# Admin alerts (SMS + WhatsApp to the admin's mobile) and OTP over WhatsApp too
# ADMIN_PHONE=9794788735
# OTP_CHANNELS=sms,whatsapp
# TWILIO_SMS_FROM=+1xxxxxxxxxx
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
